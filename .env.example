# =============================================================================
# MarketFlow v2 — Biến môi trường mẫu (.env.example)
#
# Dự án: Hệ thống quản lý chiến dịch marketing có tích hợp AI (AIA331)
# Bám sát đặc tả kỹ thuật: docs/rebuild/CONTRACT.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH BACKEND (FastAPI - app/core/config.py)
# -----------------------------------------------------------------------------
APP_NAME="MarketFlow"
# Môi trường chạy: development | test | production
APP_ENV=development
API_V1_PREFIX="/api/v1"

# Cơ sở dữ liệu:
# - Môi trường Dev/Test: SQLite cục bộ (tự động tạo tại backend/data/marketflow.db)
# - Môi trường Production / Docker: PostgreSQL 16
#   Ví dụ: postgresql://marketflow:YourSecurePassword123@127.0.0.1:5432/marketflow
DATABASE_URL="sqlite:///./data/marketflow.db"

# Bảo mật JWT (HS256):
# - Dev: Có thể để mặc định "dev-only-insecure-secret-change-me"
# - Production: BẮT BUỘC thay đổi bí mật >= 32 ký tự (Backend từ chối khởi động nếu chưa đổi)
#   Tạo ngẫu nhiên bằng lệnh: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="dev-only-insecure-secret-change-me"
JWT_ALGORITHM="HS256"
# Thời hạn hiệu lực của Access Token (phút) - 480 phút = 8 giờ
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# Danh sách nguồn CORS cho phép Frontend kết nối (phân tách bởi dấu phẩy)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://marketing.kienhieu.id.vn"

# Chống dò mật khẩu (Rate limiting đăng nhập):
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Kết nối tới dịch vụ AI Runner nội bộ (ai-runner):
# - Để trống nếu không dùng AI (chế độ quản lý chiến dịch thông thường)
# - Cục bộ: http://127.0.0.1:8100
# - Docker / VPS: http://127.0.0.1:8100 hoặc tên service mạng docker
AI_RUNNER_URL="http://127.0.0.1:8100"
# Mã bí mật bảo vệ kết nối giữa Backend và Runner (Header X-Runner-Token)
# Sinh bằng: python -c "import secrets; print(secrets.token_hex(24))"
AI_RUNNER_TOKEN=""
ASSISTANT_RUN_TOKEN_TTL_S=600
ASSISTANT_TURN_TIMEOUT_S=150

# -----------------------------------------------------------------------------
# 2. CẤU HÌNH DỊCH VỤ AI RUNNER (ai-runner/app/config.py)
# -----------------------------------------------------------------------------
# Chạy dưới tài khoản người dùng cô lập (ví dụ `mfai` trên VPS), không có quyền root
RUNNER_HOST="127.0.0.1"
RUNNER_PORT=8100
RUNNER_TOKEN=""

# Đường dẫn tệp thực thi OpenCode CLI
OPENCODE_BIN="opencode"
# Tên agent cấu hình tại deploy/opencode/agent/marketflow.md
OPENCODE_AGENT="marketflow"
# Thư mục sandbox cô lập chỉ đọc chứa .opencode/
RUNNER_SANDBOX_DIR="."

# Lựa chọn mô hình miễn phí từ OpenCode Zen:
# Mặc định: big-pickle (hoạt động tốt nhất trong thử nghiệm P0, không bịa số)
OPENCODE_MODEL="opencode/big-pickle"
# Mô hình dự phòng khi gặp rate limit (429 / FreeTierError):
OPENCODE_FALLBACK_MODELS="opencode/glm-5.3-flash-free,opencode/deepseek-v4.1-flash-free"

# Giới hạn an toàn máy chủ VPS (2 vCPU / 2GB RAM):
# BẮT BUỘC RUNNER_CONCURRENCY=1 để tránh cạn kiệt RAM (~490MB RSS mỗi tiến trình)
RUNNER_CONCURRENCY=1
RUNNER_MAX_QUEUE=8
RUNNER_TIMEOUT_S=180.0
RUNNER_MAX_PROMPT_CHARS=60000
RUNNER_KILL_GRACE_S=3.0

# -----------------------------------------------------------------------------
# 3. CẤU HÌNH FRONTEND (React SPA - frontend/.env)
# -----------------------------------------------------------------------------
# URL gốc của REST API (hoặc để trống để dùng proxy Vite tương đối /api/v1)
VITE_API_BASE_URL="/api/v1"

# Chế độ giả lập dành riêng cho DEV (không gọi backend/runner thật, dùng để test UI offline)
# BẮT BUỘC "false" trên Production (mã simulator bị Rollup loại bỏ hoàn toàn khỏi build)
VITE_ASSISTANT_SIMULATOR="false"
