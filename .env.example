APP_NAME="Marketing Campaign Management System with AI"
APP_ENV=development
API_V1_PREFIX="/api/v1"

# BẮT BUỘC đặt khác giá trị mặc định trước khi deploy production.
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ghi chú: giá trị SECRET_KEY mặc định bên dưới ĐÃ ĐƯỢC CÔNG KHAI (nó nằm trong
# file .example này). Ứng dụng vẫn khởi động được ở chế độ non-production để phục
# vụ demo, nhưng token JWT có thể bị forge. Hãy luôn đặt cả ba biến dưới đây.
SECRET_KEY="aia331-secret-key-change-in-production-super-secure"
JWT_SECRET_KEY=""
BYOK_ENCRYPTION_KEY=""

# Ẩn các biến demo trước khi chạy production (xem README mục Troubleshooting)
MARKETFLOW_MANAGER_PASSWORD=""
MARKETFLOW_MARKETER_PASSWORD=""
MARKETFLOW_APPROVER_PASSWORD=""

# Salt PBKDF2 của BYOK vault. Để trống thì ứng dụng tự sinh một salt ngẫu nhiên
# và lưu ở backend/.vault_salt (file này KHÔNG được commit). Chỉ đặt tay khi
# hạ tầng của bạn cung cấp secret riêng (Kubernetes Secret, Cloudflare Secret).
BYOK_PBKDF2_SALT=""

DATABASE_URL="sqlite:///./data/marketing_campaigns.db"

# AI Configuration.
# AI_PROVIDER phải thuộc danh sách hỗ trợ (xem backend/app/services/ai/providers.py
# là nguồn duy nhất):
#     gemini | openrouter | openai | anthropic | huggingface | ollama | opencode
# Backend TỪ CHỐI KHỞI ĐỘNG nếu giá trị nằm ngoài danh sách — trước đây một giá
# trị mặc định không hợp lệ khiến hệ thống rơi im lặng xuống template dự phòng, tức
# là người dùng tưởng đang gọi AI thật nhưng thực ra nhận nội dung mẫu.
AI_PROVIDER="gemini"
# AI_BASE_URL chỉ dùng cho provider `opencode` (endpoint OpenAI-compatible của
# opencode zen). Các provider còn lại lấy base_url từ sổ đăng ký.
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_API_KEY="your-gemini-api-key-here"
AI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true

# --- Khoá riêng theo từng provider (tầng SYSTEM của BYOK) ---
# Mỗi provider tự tra biến riêng trước, rồi mới tới AI_API_KEY chung. Nhờ vậy
# cấu hình một provider không bị "lẫn" sang provider khác.
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# HUGGINGFACE_API_KEY=""   # hoặc HF_TOKEN
# OPENCODE_API_KEY=""

# --- Trần token đầu ra cho Anthropic ---
# Anthropic BẮT BUỘC có `max_tokens` trong payload (OpenAI thì không). Giá trị mặc
# định 8192 đủ cho bộ prompt đa kênh (Facebook + TikTok 4 cảnh + Email A/B).
# Nếu model bị cắt giữa chừng, báo `stop_reason=max_tokens` và hệ thống rơi về
# Smart Fallback — tăng biến này nếu gặp tình trạng đó.
ANTHROPIC_MAX_TOKENS=8192

# --- Ollama: mô hình chạy ngay trên máy, KHÔNG cần API key ---
# Chỉ cần `ollama serve` + `ollama pull llama3.2`. Đây là đường chạy AI hoàn toàn
# cục bộ, hữu ích khi demo ở nơi mạng ngoài không ổn định.
MARKETFLOW_OLLAMA_BASE_URL=""
# Biến CỐ Ý có tiền tố MARKETFLOW_. Biến `OLLAMA_BASE_URL` không có tiền tố dễ
# đụng với biến đã có sẵn trong môi trường hệ thống của bạn, và khi đụng thì
# endpoint của hệ thống sẽ bị chuyển hướng sang nơi khác mà không có cảnh báo.

# --- HuggingFace ---
# Router OpenAI-compatible chính thức phục vụ model công khai không cần token
# (bị giới hạn tần suất). Điền token để có hạn mức cao hơn.
MARKETFLOW_HF_BASE_URL=""

# --- Anthropic: ghi đè base URL (chỉ dùng khi có proxy/gateway riêng) ---
# KHÔNG dùng tên `ANTHROPIC_BASE_URL` không tiền tố: trên nhiều máy biến đó đã
# có sẵn trong môi trường hệ thống và trỏ tới một endpoint khác.
MARKETFLOW_ANTHROPIC_BASE_URL=""
