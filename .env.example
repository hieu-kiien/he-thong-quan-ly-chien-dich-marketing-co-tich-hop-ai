APP_NAME="Marketing Campaign Management System with AI"
APP_ENV=development
API_V1_PREFIX="/api/v1"
SECRET_KEY="aia331-secret-key-change-in-production-super-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL="sqlite:///./marketing_campaigns.db"

# AI Configuration (OpenRouter Free Model)
AI_PROVIDER="openrouter"
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY="your-openrouter-api-key-here"
AI_MODEL="nex-agi/nex-n2.5-mini:free"
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true
