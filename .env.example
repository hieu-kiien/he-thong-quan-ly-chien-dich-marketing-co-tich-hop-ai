APP_NAME="Marketing Campaign Management System with AI"
APP_ENV=development
API_V1_PREFIX="/api/v1"

# BẮT BUỘC đặt khác giá trị mặc định trước khi deploy production.
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ghi chú: giá trị SECRET_KEY mặc định bên dưới ĐÃ ĐƯỢC CÔNG KHAI (nó nằm trong
# file .example này). Ứng dụng vẫn khởi động được ở chế độ non-production để phục
# vụ demo, nhưng token JWT có thể bị forge. Hãy luôn đặt cả ba biến dưới đây.
SECRET_KEY="aia331-secret-key-change-in-production-super-secure"
JWT_SECRET_KEY=""
BYOK_ENCRYPTION_KEY=""

# Ẩn các biến demo trước khi chạy production (xem README mục Troubleshooting)
MARKETFLOW_MANAGER_PASSWORD=""
MARKETFLOW_MARKETER_PASSWORD=""
MARKETFLOW_APPROVER_PASSWORD=""

# Salt PBKDF2 của BYOK vault. Để trống thì ứng dụng tự sinh một salt ngẫu nhiên
# và lưu ở backend/.vault_salt (file này KHÔNG được commit). Chỉ đặt tay khi
# hạ tầng của bạn cung cấp secret riêng (Kubernetes Secret, Cloudflare Secret).
BYOK_PBKDF2_SALT=""

DATABASE_URL="sqlite:///./data/marketing_campaigns.db"

# AI Configuration.
# AI_PROVIDER phải thuộc danh sách hỗ trợ (xem backend/app/services/ai/providers.py
# là nguồn duy nhất):
#     gemini | openrouter | openai | anthropic | huggingface | ollama | opencode
# Backend TỪ CHỐI KHỞI ĐỘNG nếu giá trị nằm ngoài danh sách — trước đây một giá
# trị mặc định không hợp lệ khiến hệ thống rơi im lặng xuống template dự phòng, tức
# là người dùng tưởng đang gọi AI thật nhưng thực ra nhận nội dung mẫu.
AI_PROVIDER="gemini"
# AI_BASE_URL chỉ dùng cho provider `opencode` (endpoint OpenAI-compatible của
# opencode zen). Các provider còn lại lấy base_url từ sổ đăng ký.
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_API_KEY="your-gemini-api-key-here"
AI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true

# --- Khoá riêng theo từng provider (tầng SYSTEM của BYOK) ---
# Mỗi provider tự tra biến riêng trước, rồi mới tới AI_API_KEY chung. Nhờ vậy
# cấu hình một provider không bị "lẫn" sang provider khác.
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# HUGGINGFACE_API_KEY=""   # hoặc HF_TOKEN
# OPENCODE_API_KEY=""

# --- Trần token đầu ra cho Anthropic ---
# Anthropic BẮT BUỘC có `max_tokens` trong payload (OpenAI thì không). Giá trị mặc
# định 8192 đủ cho bộ prompt đa kênh (Facebook + TikTok 4 cảnh + Email A/B).
# Nếu model bị cắt giữa chừng, báo `stop_reason=max_tokens` và hệ thống rơi về
# Smart Fallback — tăng biến này nếu gặp tình trạng đó.
ANTHROPIC_MAX_TOKENS=8192

# --- Ollama: mô hình chạy ngay trên máy, KHÔNG cần API key ---
# Chỉ cần `ollama serve` + `ollama pull llama3.2`. Đây là đường chạy AI hoàn toàn
# cục bộ, hữu ích khi demo ở nơi mạng ngoài không ổn định.
MARKETFLOW_OLLAMA_BASE_URL=""
# Biến CỐ Ý có tiền tố MARKETFLOW_. Biến `OLLAMA_BASE_URL` không có tiền tố dễ
# đụng với biến đã có sẵn trong môi trường hệ thống của bạn, và khi đụng thì
# endpoint của hệ thống sẽ bị chuyển hướng sang nơi khác mà không có cảnh báo.

# --- HuggingFace ---
# Router OpenAI-compatible chính thức phục vụ model công khai không cần token
# (bị giới hạn tần suất). Điền token để có hạn mức cao hơn.
MARKETFLOW_HF_BASE_URL=""

# --- Anthropic: ghi đè base URL (chỉ dùng khi có proxy/gateway riêng) ---
# KHÔNG dùng tên `ANTHROPIC_BASE_URL` không tiền tố: trên nhiều máy biến đó đã
# có sẵn trong môi trường hệ thống và trỏ tới một endpoint khác.
MARKETFLOW_ANTHROPIC_BASE_URL=""

# ==============================================================================
# HÀNG ĐỢI AI BẤT ĐỒNG BỘ (Postgres-backed, không Celery/Redis)
# ==============================================================================
# Vì sao có: các endpoint AI đồng bộ là hàm `def` nên giữ một thread của worker
# suốt thời gian chờ LLM. `/ai/omnichannel` đo mất 237 giây trên deployment thật
# (Render free: 512 MB RAM / 0.1 CPU) và Cloudflare Worker phía trước cắt ở ~100
# giây -> `error code: 524`. Hàng đợi mới đẩy việc gọi LLM ra khỏi request.
# Xem backend/app/services/jobs/queue.py và backend/app/services/ai/job_worker.py.

# Bật worker nền trong tiến trình web. Đặt false nếu chạy worker ở tiến trình riêng
# (mỗi tiến trình có hạn mức slot riêng) hoặc khi chỉ muốn dựng API.
AI_JOB_WORKER_ENABLED=true

# SỐ JOB AI CHẠY ĐỒNG THỜI TRONG MỘT TIẾN TRÌNH — đây là trần bảo vệ bộ nhớ.
# Worker chỉ nhặt job khi còn slot trống, nên hàng đợi dồn bao nhiêu job cũng không
# sinh thêm việc chạy song song.
#   1-2 : phù hợp 512 MB RAM / 0.1 CPU (giá trị mặc định)
#   >4  : chỉ khi đã nâng cấp RAM/CPU; mỗi job giữ một thread + một phiên HTTP
AI_JOB_CONCURRENCY=2

# THỜI HẠN CỨNG cho một job (giây). Quá hạn thì job bị đánh `failed` kèm lý do và
# slot được giải phóng — job kẹt không bao giờ giữ slot vô hạn.
# Mặc định 300s cao hơn thời gian đo được 237s của /ai/omnichannel để một lượt gọi
# ĐÚNG vẫn kịp xong. Hạ xuống nếu chấp nhận job dài bị báo hết giờ.
AI_JOB_TIMEOUT_SECONDS=300

# Chu kỳ quét hàng đợi (giây). Đồng thời là độ trễ tối đa phát hiện job quá hạn.
AI_JOB_POLL_INTERVAL_SECONDS=2

# Số lần thử tối đa cho một job. Retry CHỈ dành cho lỗi TẠM THỜI (mạng, timeout,
# 429, 5xx của provider); lỗi vĩnh viễn thất bại ngay để khỏi đốt tiền gọi LLM.
AI_JOB_MAX_ATTEMPTS=3

# Backoff luỹ tiến cho retry: lần n chờ min(base * 2^(n-1), max) giây. Backoff được
# lưu trong CSDL chứ không phải `sleep` trong thread, nên job đang backoff không
# giữ slot.
AI_JOB_RETRY_BASE_SECONDS=10
AI_JOB_RETRY_MAX_SECONDS=300

# Dọn job đã KẾT THÚC (succeeded/failed/cancelled) sau N ngày. Job đang chờ hoặc
# đang chạy không bao giờ bị dọn.
AI_JOB_RETENTION_DAYS=7
AI_JOB_CLEANUP_INTERVAL_SECONDS=3600
AI_JOB_CLEANUP_BATCH=200

# ==============================================================================
# HẠN MỨC GÓI MIỄN PHÍ THEO WORKSPACE
# ==============================================================================
# KHÁC `enforce_quota` trong code (rate limiter chống lạm dụng, đếm trong RAM):
# đây là GIỚI HẠN SẢN PHẨM, đếm trong CSDL theo workspace nên không mất khi
# restart tiến trình và không nhân lên theo số worker. Xem backend/app/services/quota.py.
#
# Nguyên tắc chọn số: đủ rộng để một nhóm sinh viên demo cả buổi học (20-30 người)
# không bị vướng, nhưng hữu hạn để còn ý nghĩa. Hạn mứng được THỰC THI Ở SERVER;
# việc ẩn/hiện nút ở giao diện chỉ để người dùng biết trước, không phải để chặn.

# Số AI job tính trong cửa sổ TRƯỜT 24 giờ (không phải ngày lịch UTC — múi giờ
# VN là UTC+7 nên ngày UTC cắt qua lúc 7h sáng, người demo buổi sáng sẽ thấy hạn
# mứng tự nhảy về 0 giữa chừng). Mỗi lượt gọi LLM thật mất 80-240 giây và worker
# chỉ chạy 2 job đồng thời, nên 50 lượt là "demo liên tục cả ngày" chứ không phải
# con số bịa ra. Tính NGAY LÚC NHẬN JOB (không phải lúc xong) để người dùng biết
# ngay khi vượt; retry idempotent không bị tính lần hai.
QUOTA_AI_JOBS_PER_DAY=50

# Số chiến dịch tối đa của một workspace. 25 là gấp đôi số chiến dịch một nhóm
# lớp cần để demo đầy đủ vòng đời (lập kế hoạch -> duyệt -> đăng -> đo ROI).
QUOTA_MAX_CAMPAIGNS=25

# Số bài nội dung tối đa của một workspace. Cao hơn hẳn vì đây là thứ tích luỹ
# nhiều nhất trong demo (mỗi ý tưởng AI sinh vài bản nháp); 500 vẫn đủ để một
# chiến dịch có vài chục bài mà vẫn gọi được `GET /contents` nhanh.
QUOTA_MAX_CONTENTS=500

# Số thành viên tối đa của một workspace. 10 người là cả một nhóm demo lớp học;
# con số này chặn việc một tài khoản lập workspace rồi rải hàng trăm tài khoản
# ảo vào đó.
QUOTA_MAX_WORKSPACE_MEMBERS=10

# Số lịch đăng tối đa của một workspace. Lịch đăng là tài nguyên tích luỹ khá
# vô hạn (mỗi bài APPROVED có thể lên lịch nhiều lần), nên cần một trần riêng.
QUOTA_MAX_SCHEDULES=200

# Số workspace tối đa MỘT NGƯỜI DÙNG sở hữu (tính theo user, không theo workspace).
# 5 là đủ để tách demo theo nhóm mà không phải dựng một workspace cho mỗi vai trò.
QUOTA_MAX_WORKSPACES_PER_USER=5

# ĐƯỜNG GHI ĐÈ CHO QUẢN TRỊ VIÊN: danh sách id workspace được MIỄN trần, cách
# nhau bằng dấu phẩy. Rỗng = không miễn gì. Mọi lần dùng đều được ghi log ở mức
# WARNING, để không có lớp phòng thủ nào bị bỏ qua trong im lặng.
# Cần thiết vì một admin khoá ngoài chính instance của mình thì không tự sửa được.
# Lưu ý: người dùng vai trò ADMIN đã được miễn sẵn (khớp với mô hình "ADMIN có
# phạm vi toàn cục" đang áp dụng ở mọi endpoint khác của hệ thống).
QUOTA_OVERRIDE_WORKSPACE_IDS=
