{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marketflow-kienhieu",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "SECRET_KEY",
      "JWT_SECRET_KEY",
      "BYOK_ENCRYPTION_KEY",
      "AI_API_KEY",
      "MARKETFLOW_MANAGER_PASSWORD",
      "MARKETFLOW_MARKETER_PASSWORD",
      "MARKETFLOW_APPROVER_PASSWORD",
      // Cron 5 phút/lần gọi POST /api/v1/schedules/trigger-worker. Thiếu
      // secret này thì scheduler bỏ qua mọi lần chạy (có log cảnh báo).
      "SCHEDULER_SECRET"
    ]
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "containers": [
    {
      "class_name": "FastApiContainer",
      "image": "../backend/cloudflare.Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "FastApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FastApiContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATABASE_BACKUPS",
      "bucket_name": "marketflow-production-data"
    }
  ],
  // Cron Trigger đẩy việc xử lý lịch đăng xuống Durable Object.
  // Bắt buộc vì scheduler trong container đã bị tắt (SCHEDULER_ENABLED=false) để
  // các thay đổi do scheduler ghi vào SQLite luôn được snapshot lên R2. Thiếu
  // trigger này thì lịch đăng sẽ không bao giờ chạy trên Cloudflare.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    {
      "pattern": "marketing.kienhieu.id.vn/*",
      "zone_name": "kienhieu.id.vn"
    }
  ]
}
