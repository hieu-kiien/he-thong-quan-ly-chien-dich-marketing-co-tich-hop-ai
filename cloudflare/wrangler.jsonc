{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marketflow-kienhieu",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Backend FastAPI chay o Render. Worker proxy /api/* va /health sang day.
    // Gia tri mac dinh la domain cua Render; doi o day neu backend doi ten.
    // KHONG dat trong `secrets`: day la dia chi cong khai, khong phai bi mat.
    // Ghi chu: dong comment phai nam TREN gia tri, vi comment cung hang
    // duoc bo qua khi parse JSONC.
    "BACKEND_ORIGIN": "https://marketflow-api-9onk.onrender.com"
  },
  "secrets": {
    // Chi con hai secret. Secret key/AI key/password da chuyen sang bien moi
    // truong cua Render (render.yaml) — Worker khong can chung them nua.
    // BACKEND_ORIGIN nam trong `vars` o tren.
    "required": ["SCHEDULER_SECRET"]
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  // Khong con `containers` / `durable_objects` / `r2_buckets`:
  // tai khoan nay khong co Workers Paid plan nen Cloudflare Containers khong
  // deploy duoc (tra 401 "requires the Workers Paid plan"). Da xac nhan bang
  // len deploy that: Worker upload duoc nhung moi route /api/* tra 404 vi
  // container khong khoi dong. Backend chay o Render thay cho.
// KHONG dung `migrations`:
  // `deleted_classes` bi Wrangler tu choi voi ly do "non-existent class" vi
  // config nay khong con binding `durable_objects` tro toi FastApiContainer.
  // Thay vao do src/index.ts van export stub `FastApiContainer` (tra 410) de
  // Workers chap nhan ban moi — class da ghi trong DB tim thay stub cung ten.
  // Stub khong co binding, khong side effect.
  "triggers": {
    // Scheduler chay trong container cua Render nen bi tu tat; Worker danh thuc
    // no moi 5 phut qua POST /api/v1/schedules/trigger-worker.
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    {
      "pattern": "marketing.kienhieu.id.vn/*",
      "zone_name": "kienhieu.id.vn"
    }
  ]
}