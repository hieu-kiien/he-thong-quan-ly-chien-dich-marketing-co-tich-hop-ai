digraph erd {
  graph [rankdir=LR, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.7];
  node [shape=record, fontname="Arial", fontsize=10, style="filled", fillcolor="#f8f9fc", color="#d0d5dd"];
  edge [fontname="Arial", fontsize=9, color="#4b5563"];
  Campaign [label="{Campaign|id PK|name|objective|audience|product|start/end|budget|status}", fillcolor="#f8f9fa"];
  Channel [label="{Channel|id PK|name|channel_type|is_active}", fillcolor="#f8f9fa"];
  Content [label="{Content|id PK|campaign FK|channel FK|title/body|status|source|scheduled_at|approved_by}", fillcolor="#e7ebee"];
  Metric [label="{Metric|id PK|campaign FK|channel FK|metric_date|impressions|clicks|conversions|cost}", fillcolor="#d9e0e5"];
  User [label="{User|id PK|username|role}", fillcolor="#f1f3f5"];
  User -> Campaign [label="created_by 1:N"];
  User -> Content [label="approved_by 1:N"];
  Campaign -> Content [label="1:N"];
  Campaign -> Metric [label="1:N"];
  Channel -> Content [label="1:N"];
  Channel -> Metric [label="1:N"];
}
