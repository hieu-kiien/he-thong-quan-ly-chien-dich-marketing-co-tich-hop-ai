# AIA331 / 80300 - Backend Configuration
APP_NAME="Marketing Campaign Management System with AI"
APP_ENV=development
API_V1_PREFIX="/api/v1"
SECRET_KEY="aia331-secret-key-change-in-production-super-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./marketing_campaigns.db"

# AI Provider Configuration (OpenCode / Muse Spark / OpenAI Compatible)
AI_PROVIDER="opencode"
AI_BASE_URL="https://api.opencode.ai/v1"
AI_API_KEY=""
AI_MODEL="muse-spark-1.3"
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true
