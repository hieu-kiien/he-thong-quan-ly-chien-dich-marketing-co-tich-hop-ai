# MarketFlow v2 Configuration
APP_NAME="MarketFlow"
APP_ENV=development  # development | test | production
API_V1_PREFIX="/api/v1"

# Database: SQLite cục bộ cho dev, PostgreSQL trên production VPS
DATABASE_URL="sqlite:///./data/marketflow.db"
# Production ví dụ: postgresql://marketflow:password@127.0.0.1:5432/marketflow

# JWT Auth: Bắt buộc đổi sang secret an toàn (>= 32 ký tự) trên production
JWT_SECRET="dev-only-insecure-secret-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (phân cách bằng dấu phẩy)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# AI Runner nội bộ (marketflow-ai-runner, port 8100)
AI_RUNNER_URL="http://127.0.0.1:8100"
AI_RUNNER_TOKEN="secret-runner-token-here"
