# AIA331 / 80300 - Backend Configuration
APP_NAME="Marketing Campaign Management System with AI"
APP_ENV=development
API_V1_PREFIX="/api/v1"
# KHONG duoc de san gia tri. Bat buoc sinh gia tri rieng cho moi moi truong:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./data/marketing_campaigns.db"

# AI Provider Configuration
#
# AI_PROVIDER PHẢI thuộc: gemini | openrouter | openai | opencode
#
# --- opencode (khuyến nghị cho môi trường dev, không cần mua credits) ---
# opencode zen là endpoint OpenAI-compatible, dùng đúng những model opencode
# đang cấu hình. Danh sách model hợp lệ: GET {AI_BASE_URL}/models
AI_PROVIDER="opencode"
AI_BASE_URL="https://opencode.ai/zen/v1"
# API key lấy từ ~/.config/opencode/opencode.json -> provider.opencode.options.apiKey
AI_API_KEY=""
AI_MODEL="space-bunny-free"

# --- gemini (quota miễn phí, cần key AIzaSy... từ Google AI Studio) ---
#   AI_PROVIDER="gemini"
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_API_KEY="AIzaSy..."
#   AI_MODEL="gemini-2.5-flash"

# --- openrouter ---
# Slug model phải tồn tại thật (https://openrouter.ai/models) và account phải còn
# credits. OpenRouter trả 404 cho slug đã gỡ và 402 "Insufficient credits" khi
# hết credit — cả hai đều kích hoạt Smart Fallback:
#   AI_PROVIDER="openrouter"
#   AI_BASE_URL="https://openrouter.ai/api/v1"
#   AI_MODEL="google/gemini-2.5-flash"
#   AI_API_KEY="sk-or-..."

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true

# ==============================================================================
# HANG DOI AI BAT DONG BO (Postgres-backed, khong Celery/Redis)
# ==============================================================================
# Cac endpoint AI dong bo la ham \def\ nen giu mot thread cua worker suot thoi gian
# cho LLM. \/ai/omnichannel\ do mat 237 giay tren deployment that (Render free:
# 512 MB RAM / 0.1 CPU) va Cloudflare Worker phia truoc cat o ~100 giay ->
# -> `error code: 524`. Hang doi moi day viec goi LLM ra khoi request.
# Xem backend/app/services/jobs/queue.py va backend/app/services/ai/job_worker.py.

# Bat worker nen trong tien trinh web. Dat false neu chay worker o tien trinh rieng.
AI_JOB_WORKER_ENABLED=true

# SO JOB AI CHAY DONG THOI TRONG MOT TIEN TRINH - day la tran bao ve bo nho.
# Worker chi nhat job khi con slot trong, nen hang doi don bao nhieu job cung khong
# sinh them viec chay song song. 1-2 la phu hop 512 MB RAM / 0.1 CPU.
AI_JOB_CONCURRENCY=2

# THOI HAN CUNG cho mot job (giay). Qua han thi job danh `failed` kem ly do va slot
ailed\ kem ly do va slot
# duoc giai phong - job ket khong bao gio giu slot vo han. Mac dinh 300s cao hon thoi
# gian do duoc 237s cua /ai/omnichannel de mot luot goi DUNG van kip xong.
AI_JOB_TIMEOUT_SECONDS=300

# Chu ky quet hang doi (giay). Dong thoi la do tre toi da phat hien job qua han.
AI_JOB_POLL_INTERVAL_SECONDS=2

# So lan thu toi da cho mot job. Retry CHI danh cho loi TAM THOI (mang, timeout, 429,
# 5xx cua provider); loi vinh vien that bai ngay de khoi dot tien goi LLM.
AI_JOB_MAX_ATTEMPTS=3

# Backoff luy tien cho retry: lan n cho min(base * 2^(n-1), max) giay.
AI_JOB_RETRY_BASE_SECONDS=10
AI_JOB_RETRY_MAX_SECONDS=300

# Don job da KET THUC (succeeded/failed/cancelled) sau N ngay. Job dang cho hoac dang
# chay khong bao gio bi don.
AI_JOB_RETENTION_DAYS=7
AI_JOB_CLEANUP_INTERVAL_SECONDS=3600
AI_JOB_CLEANUP_BATCH=200
