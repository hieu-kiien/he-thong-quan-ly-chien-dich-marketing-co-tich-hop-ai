# /etc/systemd/system/marketflow-api.service
#
# Tiến trình FastAPI cho MarketFlow AI (Production VPS — 2 vCPU / 2 GiB RAM).
# Đồng bộ 100% với cấu hình thực tế trên VPS:
# - Đọc biến môi trường từ /opt/marketflow/backend/.env
# - Chạy 2 Uvicorn workers với --timeout-keep-alive 75 (khớp keepalive của Nginx/Cloudflare)
# - Giới hạn bộ nhớ MemoryHigh/MemoryMax bảo vệ VPS 2 GiB RAM khỏi OOM killer.
#
# Cài đặt / Cập nhật:
#   sudo cp deploy/vps/marketflow-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now marketflow-api
#   sudo systemctl status marketflow-api

[Unit]
Description=MarketFlow AI — FastAPI backend (Production VPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marketflow
Group=marketflow
WorkingDirectory=/opt/marketflow/backend

# Tệp .env chứa SECRET_KEY, BYOK_ENCRYPTION_KEY, AI_API_KEY (chmod 600).
EnvironmentFile=/opt/marketflow/backend/.env
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="HOME=/opt/marketflow"

# 1 worker async Uvicorn tối ưu bộ nhớ RAM cho VPS 2 GiB (tiết kiệm ~140 MB RAM so với 2 workers).
ExecStart=/opt/marketflow/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --timeout-keep-alive 30 \
    --limit-concurrency 100 \
    --backlog 128 \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1"

Restart=always
RestartSec=3
TimeoutStopSec=30

# Giới hạn tài nguyên cho VPS 2 vCPU / 2 GiB RAM (tránh OOM toàn máy)
MemoryHigh=512M
MemoryMax=768M
CPUQuota=180%
LimitNOFILE=65535

# Hardening cơ bản của systemd
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marketflow /opt/marketflow/backend/data /opt/marketflow/backend

StandardOutput=journal
StandardError=journal
SyslogIdentifier=marketflow-api

[Install]
WantedBy=multi-user.target
