# /etc/systemd/system/marketflow-api.service
#
# Tien trinh FastAPI cho MarketFlow v2 (Production VPS — 2 vCPU / 2 GiB RAM).
# - Doc bien moi truong tu /opt/marketflow/backend/.env
# - Chay 1 Uvicorn worker toi uu RAM cho VPS 2 GiB
# - Gioi han bo nho MemoryHigh/MemoryMax bao ve VPS khoi OOM killer
# - Khong phu thuoc vao $HOME, ProtectHome=true bao ve he thong
#
# Cai dat / Cap nhat:
#   sudo cp deploy/vps/marketflow-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart marketflow-api
#   sudo systemctl status marketflow-api

[Unit]
Description=MarketFlow AI — FastAPI backend v2 (Production VPS)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=marketflow
Group=marketflow
WorkingDirectory=/opt/marketflow/backend

# Tep .env chua DATABASE_URL, JWT_SECRET, AI_RUNNER_TOKEN... (chmod 600)
EnvironmentFile=/opt/marketflow/backend/.env
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="HOME=/opt/marketflow"

ExecStart=/opt/marketflow/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --timeout-keep-alive 30 \
    --limit-concurrency 100 \
    --backlog 128 \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1"

Restart=always
RestartSec=3
TimeoutStopSec=30

# Gioi han tai nguyen cho VPS 2 vCPU / 2 GiB RAM (tranh OOM toan may)
MemoryHigh=512M
MemoryMax=768M
CPUQuota=180%
LimitNOFILE=65535

# Hardening systemd
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marketflow /opt/marketflow/backend

StandardOutput=journal
StandardError=journal
SyslogIdentifier=marketflow-api

[Install]
WantedBy=multi-user.target
