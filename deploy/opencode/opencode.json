{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "lsp": false,
  "formatter": false,
  "agent": {
    "title": {
      "disable": true
    },
    "summary": {
      "disable": true
    },
    "compaction": {
      "disable": true
    }
  },
  "mcp": {
    "marketflow": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MF_RUN_TOKEN}"
      }
    }
  }
}
