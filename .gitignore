# Tệp phụ sinh khi biên dịch LaTeX
**/*.aux
**/*.log
**/*.out
**/*.toc
**/*.lof
**/*.lot
**/*.synctex.gz

# Thư mục build và QA có thể tái tạo
**/_qa*/
**/build*/
**/$build*/
**/main.pdf
**/*.fls
**/*.fdb_latexmk
**/*.err
_current_project_inventory.json

# Tệp tạm của Microsoft Office
~$*.docx

# Python & Backend
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite3
**/test-results.json

# Environment & Secrets
.env
*.env
**/.env
**/.env.*
!*.example

# GitNexus local cache & database
.gitnexus/

# Node & Frontend
**/node_modules/
frontend/dist/
**/.npm/

# Testing & Temporary Artifacts
test-recordings/
*.png
playwright-report/
test-results/
.agents/
.wrangler/
cloudflare/worker-configuration.d.ts
cloudflare/.local-credentials.txt

# Test / coverage artifacts
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Local database (được mount vào container qua docker-compose).
# Dùng `/*` thay vì `/` để git vẫn descend vào thư mục, nhờ vậy .gitkeep được track.
backend/data/*
!backend/data/.gitkeep

# Local credentials that must never be committed
*.sqlite
*.sqlite3

