# Environment & Secrets
.env
*.env
**/.env
**/.env.*
!*.example

# GitNexus local cache & database
.gitnexus/

# Node & Frontend
**/node_modules/
frontend/dist/
**/.npm/

# Testing & Temporary Artifacts
test-recordings/
*.png
.agents/

