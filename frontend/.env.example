# MarketFlow v2 — cấu hình frontend (Vite). Sao chép thành `.env.local` khi chạy dev.
# Mọi biến VITE_* được nhúng vào bundle lúc build: KHÔNG đặt bí mật ở đây.

# Đường dẫn gốc API. Mặc định `/api/v1` (cùng origin: Vite proxy khi dev, Nginx khi production).
VITE_API_URL=/api/v1

# Chỉ dùng khi dev: dòng gợi ý hiển thị dưới form đăng nhập (vd tài khoản demo cục bộ).
# Chỉ được hiển thị khi chạy `npm run dev`; bị bỏ qua trong bản build production.
VITE_DEV_LOGIN_HINT=

# (Tuỳ chọn, chỉ cho `npm run dev`) địa chỉ backend để Vite proxy `/api`. Mặc định http://localhost:8000
# VITE_DEV_API_TARGET=http://localhost:8000
